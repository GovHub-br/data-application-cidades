# Gerenciado pelo Ansible (infra/playbooks/airflow/install-airflow.yaml).
# Edições à mão somem na próxima execução: mude o group_vars ou o extra.env.

# <---------- Airflow ---------->
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY={{ airflow_fernet_seed | b64encode | replace('+', '-') | replace('/', '_') }}
AIRFLOW__API__SECRET_KEY={{ airflow_api_secret_key }}
AIRFLOW__API_AUTH__JWT_SECRET={{ airflow_jwt_secret }}
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://{{ airflow_db_user }}:{{ airflow_db_password | urlencode }}@{{ postgres_host }}:{{ postgres_port }}/{{ airflow_db_name }}

# Usados pela DAG do OpenMetadata para ler o banco do próprio Airflow.
AIRFLOW_HOST_PORT=http://localhost:{{ airflow_port }}
AIRFLOW_DB_HOST_PORT={{ postgres_host }}:{{ postgres_port }}
AIRFLOW_DB_DATABASE={{ airflow_db_name }}
POSTGRES_USER={{ airflow_db_user }}
POSTGRES_PASSWORD={{ airflow_db_password }}

# <---------- Postgres Data Warehouse MCID (Cidades) ---------->
DB_DW_HOST_MCID={{ postgres_host }}
DB_DW_PORT_MCID={{ postgres_port }}
DB_DW_DBNAME_MCID={{ dw_db_name }}
DB_DW_USER_MCID={{ dw_db_user }}
DB_DW_PASSWORD_MCID={{ dw_db_password }}
# Connection que as DAGs usam (helpers/postgres_helpers.py). Definida por
# ambiente, ela funciona mas não aparece na lista da UI.
AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql://{{ dw_db_user }}:{{ dw_db_password | urlencode }}@{{ postgres_host }}:{{ postgres_port }}/{{ dw_db_name }}

# <---------- Lake (RustFS) ---------->
MINIO_ENDPOINT={{ lake_s3_endpoint }}
MINIO_ACCESS_KEY={{ lake_s3_access_key }}
MINIO_SECRET_KEY={{ lake_s3_secret_key }}
MINIO_BUCKET={{ lake_bucket }}
{% if airflow_extra_env | length > 0 %}

# <---------- extra.env (SFTP, OpenMetadata, mascaramento...) ---------->
{{ airflow_extra_env }}
{% endif %}
