# Gerenciado pelo Ansible (infra/playbooks/openmetadata/install-openmetadata.yaml).
# Só o que difere do padrão da imagem; a referência é o docker-compose oficial
# do OpenMetadata {{ openmetadata_version }} (docker-compose-postgres.yml).

OPENMETADATA_CLUSTER_NAME=cidades
SERVER_PORT={{ openmetadata_port }}
SERVER_ADMIN_PORT=8586
LOG_LEVEL=INFO
OPENMETADATA_HEAP_OPTS=-Xmx{{ openmetadata_heap }} -Xms{{ openmetadata_heap }}

# Autenticação básica (usuário/senha no próprio OpenMetadata)
AUTHENTICATION_PROVIDER=basic
AUTHORIZER_CLASS_NAME=org.openmetadata.service.security.DefaultAuthorizer
AUTHORIZER_REQUEST_FILTER=org.openmetadata.service.security.JwtFilter
AUTHORIZER_ADMIN_PRINCIPALS=[admin]
AUTHORIZER_INGESTION_PRINCIPALS=[ingestion-bot]
AUTHORIZER_PRINCIPAL_DOMAIN=open-metadata.org
AUTHENTICATION_PUBLIC_KEYS=[http://localhost:{{ openmetadata_port }}/api/v1/system/config/jwks]

# Chaves que assinam os tokens (do admin e do ingestion-bot). Geradas na VM:
# as que vêm na imagem são as mesmas em toda instalação do OpenMetadata.
RSA_PUBLIC_KEY_FILE_PATH=/opt/openmetadata/conf/cidades/public_key.der
RSA_PRIVATE_KEY_FILE_PATH=/opt/openmetadata/conf/cidades/private_key.der
JWT_ISSUER=open-metadata.org
JWT_KEY_ID=cidades-openmetadata

# Banco: database "{{ openmetadata_db_name }}" na VM do Postgres
DB_DRIVER_CLASS=org.postgresql.Driver
DB_SCHEME=postgresql
DB_PARAMS=allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_HOST={{ postgres_host }}
DB_PORT={{ postgres_port }}
OM_DATABASE={{ openmetadata_db_name }}
DB_USER={{ openmetadata_db_user }}
DB_USER_PASSWORD={{ openmetadata_db_password }}

# Busca: o Elasticsearch desta VM, só no loopback
SEARCH_TYPE=elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# A ingestão roda no Airflow do projeto (openmetadata_ingestion_dag), não num
# Airflow do próprio OpenMetadata: o cliente de pipeline fica desligado.
PIPELINE_SERVICE_CLIENT_ENABLED=false
SERVER_HOST_API_URL=http://localhost:{{ openmetadata_port }}/api

FERNET_KEY={{ openmetadata_fernet_seed | b64encode }}
SECRET_MANAGER=db
