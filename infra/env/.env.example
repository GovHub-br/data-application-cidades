# <---------- Airflow ---------->

AIRFLOW_IMAGE_NAME=apache/airflow:latest
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_HOME=/opt/airflow/
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_UID=50000


# <---------- Postgres Airflow ---------->

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=postgres_dw
POSTGRES_PASSWORD_DW=postgres_dw
POSTGRES_DB_DW=data_warehouse


# <---------- MinIO ---------->
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=data-lake-ipea

# <---------- Postgres Data Warehouse MCID (Cidades) ---------->
DB_DW_HOST_MCID=
DB_DW_USER_MCID=
DB_DW_PASSWORD_MCID=
DB_DW_PORT_MCID=
DB_DW_DBNAME_MCID=
DB_DW_SCHEMA_MCID=

# <---------- Credenciais do servidor SFTP do MCID (Cidades) ---------->
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=


# <---------- OpenMetadata (catálogo de dados) ---------->
# A instância é compartilhada entre ministérios. URL e token vêm de quem a
# administra; o service e o database já existem lá e NÃO são criados pelo
# sync — ele só documenta os dois.
#
# OPENMETADATA_JWT_TOKEN deve ser o token do bot de ingestão, não o de uma
# pessoa: assim a auditoria do catálogo distingue automação de edição manual.
OPENMETADATA_URL=
OPENMETADATA_JWT_TOKEN=
# Nome do Database Service no OpenMetadata (o warehouse Postgres do MCid).
OPENMETADATA_DATABASE_SERVICE=
# Nome do database dentro desse service.
OPENMETADATA_DATABASE_NAME=
