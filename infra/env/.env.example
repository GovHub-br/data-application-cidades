# <---------- Airflow ---------->

AIRFLOW_IMAGE_NAME=apache/airflow:latest
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_HOME=/opt/airflow/
AIRFLOW_UID=50000


# <---------- Postgres Airflow ---------->

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=postgres_dw
POSTGRES_PASSWORD_DW=postgres_dw
POSTGRES_DB_DW=data_warehouse


# <---------- MinIO ---------->
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=data-lake-ipea

# <---------- Ingestão (plugins/ingestion) ---------->
# O storage do lake usa o S3Hook com esta Connection; o bucket vem de MINIO_BUCKET.
# Mesmas credenciais do MinIO acima, com o endpoint no extra.
AIRFLOW_CONN_MINIO_LAKE='{"conn_type": "aws", "login": "minioadmin", "password": "minioadmin", "extra": {"endpoint_url": "http://minio:9000", "region_name": "us-east-1"}}'
# Opcionais: s3 (padrão) ou local; outra Connection; raiz do backend local.
# INGESTION_STORAGE_BACKEND=s3
# INGESTION_STORAGE_CONN_ID=minio_lake
# INGESTION_LOCAL_ROOT=/opt/airflow/lake_tmp/lake
# Validação: tudo vai para <bucket>/tests/ (nunca raw/ nem staging/). Vazio em prod.
# INGESTION_STORAGE_PREFIX=tests/
# Testes de integração do storage: gravam só em <bucket>/<prefixo>/<uuid>/ e apagam no fim.
# O prefixo nunca pode ser raw/ nem staging/.
# INGESTION_TEST_BUCKET=data-lake-mcid
# INGESTION_TEST_PREFIX=tests/
# 1 = não apaga o que os testes gravaram (para ver no console do MinIO).
# INGESTION_TEST_KEEP=1
# Fontes dos extratores (uma Connection por fonte; o segredo fica só aqui).
AIRFLOW_CONN_HTTP_BACEN='{"conn_type": "http", "host": "api.bcb.gov.br", "schema": "https"}'
# Série histórica do INCC-M (incc_m_ingest_dag).
AIRFLOW_CONN_HTTP_SINDUSCON='{"conn_type": "http", "host": "sindusconpr.com.br", "schema": "https"}'
# Mesmos dados da Variable email_credentials (imap_server, email, password).
AIRFLOW_CONN_IMAP_TESOURO='{"conn_type": "imap", "host": "", "login": "", "password": ""}'

# <---------- Postgres Data Warehouse MCID (Cidades) ---------->
DB_DW_HOST_MCID=
DB_DW_USER_MCID=
DB_DW_PASSWORD_MCID=
DB_DW_PORT_MCID=
DB_DW_DBNAME_MCID=
DB_DW_SCHEMA_MCID=

# <---------- Credenciais do servidor SFTP do MCID (Cidades) ---------->
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=


# <---------- OpenMetadata (catálogo de dados) ---------->
# A instância é compartilhada entre ministérios. URL e token vêm de quem a
# administra; o service e o database já existem lá e NÃO são criados pelo
# sync — ele só documenta os dois.
#
# OPENMETADATA_JWT_TOKEN deve ser o token do bot de ingestão, não o de uma
# pessoa: assim a auditoria do catálogo distingue automação de edição manual.
OPENMETADATA_URL=
OPENMETADATA_JWT_TOKEN=
# Nome do Database Service no OpenMetadata (o warehouse Postgres do MCid).
OPENMETADATA_DATABASE_SERVICE=
# Nome do database dentro desse service.
OPENMETADATA_DATABASE_NAME=

# <---------- Ingestão do OpenMetadata (DAG openmetadata_ingestion_dag) ------>
# A DAG usa OPENMETADATA_URL e OPENMETADATA_JWT_TOKEN, declarados acima. Ela lê
# do AMBIENTE e não de Variable do Airflow: as tasks rodam num virtualenv
# isolado sem o pacote `airflow` instalado, e lá dentro não há `Variable` para
# consultar. O isolamento existe porque o `openmetadata-ingestion` rebaixa
# dependências da imagem base do Airflow (ver helpers/openmetadata/config.py).

# Liga/desliga por recipe. São variáveis de AMBIENTE, não Variables, porque a
# decisão acontece no parse da DAG.
# Ligadas por padrão: postgres, dbt e airflow.
OM_INGEST_POSTGRES=true
OM_INGEST_DBT=true
OM_INGEST_AIRFLOW=true
# Superset exige credencial própria (abaixo).
OM_INGEST_SUPERSET=false
# Profiler e classifier LEEM LINHAS do banco para calcular estatística e
# detectar PII. Ligar é decisão de governança, não de configuração.
OM_INGEST_PROFILER=false
OM_INGEST_CLASSIFIER=false

# Endereços internos, nomes de serviço do compose.
AIRFLOW_HOST_PORT=http://airflow:8080
AIRFLOW_DB_HOST_PORT=postgres:5432
AIRFLOW_DB_DATABASE=airflow

# Só necessários com OM_INGEST_SUPERSET=true.
# URL do Superset. `SUPERSET_HOST_PORT` é o nome que a integração do
# OpenMetadata usa; `SUPERSET_URL` é o que os scripts de dashboard pedem.
# Mesmo valor — defina os dois, ou só um: os scripts aceitam qualquer um.
SUPERSET_HOST_PORT=
SUPERSET_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=

