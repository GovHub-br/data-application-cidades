# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=postgres_dw
POSTGRES_PASSWORD_DW=postgres_dw
POSTGRES_DB_DW=data_warehouse


# <---------- MinIO ---------->
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=data-lake-ipea

# <---------- Postgres Data Warehouse MCID (Cidades) ---------->
DB_DW_HOST_MCID=
DB_DW_USER_MCID=
DB_DW_PASSWORD_MCID=
DB_DW_PORT_MCID=
DB_DW_DBNAME_MCID=
DB_DW_SCHEMA_MCID=

# <---------- SFTP do MCID (Cidades), conta fábrica ---------->
# A sftp_ingest_dag usa o SFTPHook com esta Connection (antes, SFTP_HOST/PORT/USER/PASSWORD).
AIRFLOW_CONN_SFTP_MCID='{"conn_type": "sftp", "host": "", "port": 22, "login": "", "password": "", "extra": {"no_host_key_check": true}}'
# Segredo do HMAC do mascaramento (CPF/NIS viram token antes do pouso na raw). Usar o
# mesmo segredo de sempre: trocar muda todos os tokens e quebra junções entre cargas.
MASKING_HMAC_SECRET=
