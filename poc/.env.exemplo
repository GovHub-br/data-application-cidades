# Variáveis da POC. Copie para poc/.env (ignorado pelo git).
# ATENÇÃO: prefixo POC_ de propósito — as MINIO_*/DB_DW_* do .env da raiz apontam
# para PRODUÇÃO e não devem ser reutilizadas aqui.

# MinIO local (container). O DuckDB quer host[:porta] SEM esquema;
# o ClienteMinio (boto3) quer a mesma coisa e prefixa http:// sozinho.
POC_MINIO_ENDPOINT=localhost:9100
POC_MINIO_ACCESS_KEY=pocadmin
POC_MINIO_SECRET_KEY=pocadmin123
POC_MINIO_BUCKET=poc-lake

# Postgres local (container) — destino da silver
POC_PG_HOST=localhost
POC_PG_PORT=5442
POC_PG_USER=poc
POC_PG_PASSWORD=poc
POC_PG_DBNAME=poc_dw

# Arquivo de banco do DuckDB (não usar :memory: — o ATTACH e as macros precisam persistir)
POC_DUCKDB_PATH=../.duckdb/poc.duckdb

# Timestamp fixo de ingestão: torna os parquets byte-comparáveis entre execuções
POC_INGESTED_AT=2026-08-05T00:00:00

# Endpoint visto de DENTRO da rede do compose (o Postgres é container: localhost != host)
POC_MINIO_ENDPOINT_INTERNO=minio:9000
